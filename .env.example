# Copy this file to .env.local for local development, or add the same
# variables in Vercel -> your project -> Settings -> Environment Variables.
# EVERYTHING here is optional — the site works with none of these set, and
# each feature below just quietly disables itself until its variables exist.

# --- Analytics -----------------------------------------------------------
# Google Analytics 4 Measurement ID (looks like G-XXXXXXX).
# Get one free at https://analytics.google.com -> Admin -> Data Streams.
NEXT_PUBLIC_GA_ID=

# --- Persistent storage (click counts, email list) ------------------------
# Free Redis database from https://console.upstash.com -> Create Database
# -> REST API tab. Required for the click dashboard / email capture to work
# reliably on Vercel (serverless has no shared local disk). Without this,
# those features fall back to a local JSON file that only works when you
# self-host the site on your own always-on machine/server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard --------------------------------------------------------
# Password for the /admin/links click-tracking dashboard. Pick anything.
ADMIN_DASHBOARD_PASSWORD=

# --- Telegram bot & Mini App ------------------------------------------------
# Create a bot for free: message @BotFather on Telegram, send /newbot,
# follow the prompts, it gives you a token like 123456:ABC-...
TELEGRAM_BOT_TOKEN=
# The channel your daily "Tool of the Day" bot posts into, e.g. @yourchannel
# (bot must be added as an admin of that channel first).
TELEGRAM_CHANNEL_ID=
# --- Gated bot: sell "unlock all tools" access (scripts/telegram-bot.mjs) ---
# How many Telegram Stars "unlock all" costs. Stars need zero extra setup —
# no payment processor account required. Default if unset: 99.
TELEGRAM_STARS_PRICE=99
# Optional alternative payment method: a Stripe Payment Link URL
# (https://dashboard.stripe.com -> Payment Links -> create one) adds a
# "Pay with card" button alongside the Stars option, for real-currency sales.
STRIPE_PAYMENT_LINK=
# Only needed if you set STRIPE_PAYMENT_LINK above, so the confirmation
# webhook (app/api/webhooks/stripe/route.ts) can verify payments and mark
# the buyer unlocked. From https://dashboard.stripe.com/apikeys and
# https://dashboard.stripe.com/webhooks (after adding the endpoint — see
# that file's comment for the exact URL and event to select).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI-written reviews ------------------------------------------------------
# Your own Anthropic API key, for scripts/generate-reviews.mjs to draft
# longer tool reviews automatically. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Email capture -----------------------------------------------------------
# Optional: connect the homepage email signup form to a real email provider.
# Leave blank and signups are just stored via the KV store above instead
# (exportable from the admin dashboard).
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=
